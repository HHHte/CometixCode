      "newCache": true,
      "raw": "{\n  \"version\": 2,\n  \"plugins\": {\n    \"external@m\": [\n      {\n        \"scope\": \"user\",\n        \"installPath\": \"/external\"\n      }\n    ],\n    \"p@m\": [\n      {\n        \"scope\": \"project\",\n        \"installPath\": \"/new\",\n        \"version\": \"1\",\n        \"installedAt\": \"T\",\n        \"lastUpdated\": \"U\",\n        \"gitCommitSha\": \"sha\",\n        \"projectPath\": \"/current\"\n      }\n    ]\n  }\n}"
